generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMINISTRADOR
  JEFATURA
  ABOGADO
  PSICOLOGO
  SOCIAL
  SECRETARIA
  REFERENTE_TUTOR
}

enum DocumentType {
  CI
  PASAPORTE
  PARTIDA_NACIMIENTO
  SIN_DOCUMENTO
}

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

enum CaseType {
  DENUNCIA_VULNERACION
  CONSUMO_SUSTANCIAS
  VENTA_ALCOHOL
  DERECHO_EDUCACION
  EXTRAVIO
  NNA_INFRACTOR
  FISCALIZACION
}

enum Phase {
  DERIVACION
  EVALUACION
  SEGUIMIENTO
  JUDICIALIZACION
  CIERRE
}

enum InterventionPath {
  GESTION_ADMINISTRATIVA
  CONCILIACION
  VIA_JUDICIAL
}

enum RiskLevel {
  BAJO
  MEDIO
  ALTO
}

enum RoleInCase {
  NNA
  DENUNCIANTE
  DENUNCIADO
  TUTOR
  TESTIGO
}

enum ActionType {
  NOTA
  ENTREVISTA
  VISITA_DOMICILIARIA
  AUDIENCIA
  DERIVACION
  CONTACTO_INSTITUCIONAL
  OTRO
}

enum ReportCategory {
  INFORME_SOCIAL
  INFORME_PSICOLOGICO
  INFORME_PSICOSOCIAL
  INFORME_JURIDICO
  INFORME_SESION_SEGUIMIENTO
  INFORME_FINAL_CONCILIACION
  INFORME_COMPLEMENTARIO // NUEVO
}

enum ReportStatus {
  BORRADOR
  EMITIDO
}

enum AppointmentType {
  ENTREVISTA
  AUDIENCIA
  VISITA_DOMICILIARIA
  SEGUIMIENTO
  OTRO
}

enum AppointmentStatus {
  PROPUESTA       // creada por secretaria, espera respuesta del profesional
  PROGRAMADA      // profesional aceptó tal cual
  CONFIRMADA      // profesional confirmó con cambios propios
  COMPLETADA
  CANCELADA
  REPROGRAMADA    // profesional propuso otra fecha
  NO_ASISTIO
  RECHAZADA       // profesional no puede y no propone alternativa
}

enum NotificationType {
  PLAZO_LEGAL
  RIESGO_ALTO
  ASIGNACION
  DERIVACION
  GENERAL
}

enum Priority {
  NORMAL
  URGENTE
  CRITICA
}

enum TranscriptionStatus {
  DIGITAL_NATIVO
  OCR_AUTOMATICO
  VALIDADO_HUMANO
}

enum InspectionEvidenceType {
  FOTO
  VIDEO
  DOCUMENTO
}

enum InspectionSeverity {
  BAJA
  MEDIA
  ALTA
}

enum QuestionnaireCategory {
  PSICOLOGICO
  SOCIAL
  JURIDICO
  GENERAL
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
  BOOLEAN
  RATING
  DATE
}

enum QuestionnaireResponseStatus {
  PENDIENTE
  COMPLETADA
  REVISADA
}

enum TranscriptionTaskStatus {
  PENDIENTE
  PROCESSING
  COMPLETADA
  ERROR
}

enum DiscrepancyRiskLevel {
  BAJO
  MEDIO
  ALTO
}

enum ProcessualStatus {
  EN_TIEMPO
  PROXIMO
  VENCIDO
}

enum ProcessualAlertLevel {
  VERDE
  AMARILLO
  ROJO
}

enum StreetPhase {
  ADHERENCIA
  REHABILITACION
  REINTEGRACION
}

enum DigitalPlatform {
  WHATSAPP
  TIKTOK
  INSTAGRAM
  FACEBOOK
  ONLYFANS
  TELEGRAM
  X_TWITTER
  OTRO
}

enum TravelType {
  NACIONAL
  INTERNACIONAL
}

enum TravelCompanionType {
  AMBOS_PADRES
  PADRE_SOLO
  MADRE_SOLA
  TERCERO_AUTORIZADO
  SOLO
}

enum ProtectionMeasureType {
  ACOGIMIENTO_CIRCUNSTANCIAL
  INTEGRACION_RED_APOYO
  RESTITUCION_DOMICILIARIA
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             Role
  officeId         String?   @db.Uuid
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  office                 Office?                   @relation(fields: [officeId], references: [id])
  createdPersons         Person[]                  @relation("CreatedPersons")
  createdCases           Case[]                    @relation("CreatedCases")
  closedCases            Case[]                    @relation("ClosedCases")
  disabledCases          Case[]                    @relation("DisabledCases")
  createdCaseParties     CaseParty[]               @relation("CreatedCaseParties")
  assignedCaseTeam       CaseTeamHistory[]         @relation("AssignedTeam")
  performedAssignments   CaseTeamHistory[]         @relation("PerformedAssignments")
  performedTransfers     CaseOfficeHistory[]       @relation("TransferredOffice")
  performedPathChanges   InterventionPathHistory[] @relation("PathChangedBy")
  authoredActions        ActionLog[]               @relation("ActionAuthor")
  authoredReports        Report[]                  @relation("ReportAuthor")
  coAuthoredReports      Report[]                  @relation("ReportCoAuthor")
  uploadedEvidences      Evidence[]                @relation("EvidenceUploader")
  inspectionEvidenceUploaded InspectionEvidenceFile[] @relation("InspectionEvidenceUploader")
  createdAppointments    Appointment[]             @relation("CreatedAppointments")
  assignedAppointments   Appointment[]             @relation("AssignedAppointments")
  notifications          Notification[]            @relation("UserNotifications")
  escalatedNotifications Notification[]            @relation("EscalatedNotifications")
  auditLogs              AuditLog[]
  systemSettings         SystemSetting[]
  inspections            Inspection[]

  disciplineId String?     @db.Uuid
  discipline   Discipline? @relation(fields: [disciplineId], references: [id])
  
  questionnairesCreated   QuestionnaireTemplate[]   @relation("QuestionnaireCreator")
  questionnairesAnswered  QuestionnaireResponse[]   @relation("QuestionnaireResponses")
  transcriptionsCreated   Transcription[]           @relation("TranscriptionsCreated")
  
  discrepancyAnalysisCreated DiscrepancyAnalysis[]  @relation("DiscrepancyAnalysts")
  penalTypicityAnalysisCreated PenalTypicityAnalysis[] @relation("PenalTypicityAnalysts")
  processualDeadlineCreated ProcessualDeadline[]     @relation("ProcessualDeadlineCreators")

  riskScaleAnalysesCreated       RiskScaleAnalysis[]       @relation("RiskScaleAnalysts")
  clinicalTranslationsCreated    ClinicalTranslation[]     @relation("ClinicalTranslationCreators")
  traumaAnalysesCreated          TraumaAnalysis[]          @relation("TraumaAnalysts")
  environmentalMappingsCreated   EnvironmentalMapping[]    @relation("EnvironmentalMappingAnalysts")

  transversalTimelinesCreated TransversalUnifiedTimeline[] @relation("TransversalTimelineCreators")
  transversalReportsCreated TransversalAnonymizedReport[] @relation("TransversalReportCreators")

  socialIntakeForms          SocialIntakeForm[]          @relation("SocialIntakeForms")
  conciliationEvaluations    ConciliationEvaluation[]    @relation("ConciliationEvaluations")
  conciliationProcesses      ConciliationProcess[]       @relation("ConciliationProcesses")

  disabilityReports          DisabilityReport[]          @relation("UserDisabilityReports")
  reviewedDisabilityReports  DisabilityReport[]          @relation("ReviewedDisabilityReports")

  @@map("users")
}

model Office {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users           User[]
  currentCases    Case[]              @relation("CurrentOfficeCases")
  officeHistories CaseOfficeHistory[]

  @@map("offices")
}

model Person {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType   DocumentType @default(SIN_DOCUMENTO)
  documentNumber String?
  firstName      String
  lastName       String
  birthDate      DateTime?    @db.Date
  gender         Gender       @default(OTRO)
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  createdBy      String       @db.Uuid

  creator     User        @relation("CreatedPersons", fields: [createdBy], references: [id])
  caseParties CaseParty[]

  @@map("persons")
}

model Case {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseCode                String           @unique
  caseType                CaseType
  currentPhase            Phase            @default(DERIVACION)
  currentInterventionPath InterventionPath @default(GESTION_ADMINISTRATIVA)
  riskLevel               RiskLevel?
  intakeNarrative         String
  isClosed                Boolean          @default(false)
  closedAt                DateTime?        @db.Timestamptz(6)
  closedBy                String?          @db.Uuid
  closureReason           String?
  accessPinHash           String?
  currentOfficeId         String           @db.Uuid
  createdAt               DateTime         @default(now()) @db.Timestamptz(6)
  createdBy               String           @db.Uuid
  updatedAt               DateTime         @updatedAt @db.Timestamptz(6)

  creator       User                      @relation("CreatedCases", fields: [createdBy], references: [id])
  closer        User?                     @relation("ClosedCases", fields: [closedBy], references: [id])
  currentOffice Office                    @relation("CurrentOfficeCases", fields: [currentOfficeId], references: [id])
  parties       CaseParty[]
  teamHistory   CaseTeamHistory[]
  officeHistory CaseOfficeHistory[]
  pathHistory   InterventionPathHistory[]
  actionLogs    ActionLog[]
  reports       Report[]
  evidences     Evidence[]
  appointments  Appointment[]
  notifications Notification[]
  
  inspections   Inspection[]
  questionnaires QuestionnaireResponse[]
  transcriptions Transcription[]
  
  discrepancyAnalyses DiscrepancyAnalysis[] @relation("CaseDiscrepancies")
  penalTypicityAnalyses PenalTypicityAnalysis[] @relation("CasePenalTypicities")
  processualDeadlines ProcessualDeadline[] @relation("CaseProcessualDeadlines")

  riskScaleAnalyses      RiskScaleAnalysis[]    @relation("CaseRiskScaleAnalyses")
  clinicalTranslations   ClinicalTranslation[]  @relation("CaseClinicalTranslations")
  traumaAnalyses         TraumaAnalysis[]       @relation("CaseTraumaAnalyses")
  environmentalMappings  EnvironmentalMapping[] @relation("CaseEnvironmentalMappings")

  transversalTimelines TransversalUnifiedTimeline[] @relation("CaseTransversalTimelines")
  transversalReports TransversalAnonymizedReport[] @relation("CaseTransversalReports")

  socialIntakeForm        SocialIntakeForm?
  conciliationEvaluation  ConciliationEvaluation?
  conciliationProcesses   ConciliationProcess[]
  
  disabilityReports       DisabilityReport[]       @relation("CaseDisabilityReports")
  caseChunks              CaseChunk[]              @relation("CasechunkCase")

  // Banderas de situación especial de la denuncia (normativa boliviana)
  menorAutodenuncia    Boolean @default(false)
  denunciaAnonima      Boolean @default(false)
  involucraFuncionario Boolean @default(false)

  // Denunciante tercero (cuando no es el NNA mismo)
  isThirdPartyComplainant Boolean  @default(false)
  complainantFullName     String?
  complainantDocumentId   String?
  complainantRelation     String?  // MADRE, PADRE, TIO, DOCENTE, VECINO, OTRO, ETC
  complainantPhone        String?
  complainantAddress      String?

  // Datos demográficos del NNA
  nnaBirthDate            DateTime? @db.Date
  nnaGender              Gender?
  nnaCity                String?
  nnaPhone               String?
  nnaAddress             String?

  // Campos de auditoría inmutable
  isDisabled             Boolean   @default(false)
  disabledAt             DateTime? @db.Timestamptz(6)
  disabledBy             String?   @db.Uuid
  disabledReason         String?
  disabledReportId       String?   @db.Uuid // Link al reporte generado
  
  // Relaciones para auditoría
  disabler               User?     @relation("DisabledCases", fields: [disabledBy], references: [id])

  // Procedimientos especializados y medidas de protección
  violenciaDigital      SpecViolenceDigital?
  trabajoNNATS          SpecTrabajoNNATS?
  situacionCalle        SpecSituacionCalle?
  violenciaSexualILE    SpecViolenciaSexualILE?
  travelPermission      TravelPermission?
  protectionMeasures    ProtectionMeasure[]
  conciliationAgreement ConciliationAgreement?

  @@index([currentPhase])
  @@index([riskLevel])
  @@index([isClosed])
  @@index([isDisabled])
  @@index([currentOfficeId])
  @@map("cases")
}

model DisabilityReport {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId             String    @db.Uuid
  caseCode           String
  reason             String
  disabledBy         String    @db.Uuid
  disabledAt         DateTime  @default(now()) @db.Timestamptz(6)
  reviewedBy         String?   @db.Uuid
  reviewedAt         DateTime? @db.Timestamptz(6)
  status             String    @default("PENDING") // PENDING, REVIEWED, APPROVED
  
  case               Case      @relation("CaseDisabilityReports", fields: [caseId], references: [id])
  disabler           User      @relation("UserDisabilityReports", fields: [disabledBy], references: [id])
  reviewer           User?     @relation("ReviewedDisabilityReports", fields: [reviewedBy], references: [id])

  @@index([disabledAt])
  @@index([status])
  @@map("disability_reports")
}

model CaseParty {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String     @db.Uuid
  personId   String     @db.Uuid
  roleInCase RoleInCase
  isPrimary  Boolean    @default(false)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  createdBy  String     @db.Uuid

  case    Case   @relation(fields: [caseId], references: [id])
  person  Person @relation(fields: [personId], references: [id])
  creator User   @relation("CreatedCaseParties", fields: [createdBy], references: [id])

  @@unique([caseId, personId, roleInCase])
  @@map("case_parties")
}

model CaseTeamHistory {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId                 String    @db.Uuid
  userId                 String    @db.Uuid
  role                   Role
  startDate              DateTime  @default(now()) @db.Timestamptz(6)
  endDate                DateTime? @db.Timestamptz(6)
  reason                 String
  assignedBy             String    @db.Uuid
  requiredSessions       Int       @default(1)
  completedSessions      Int       @default(0)
  isInterventionFinished Boolean   @default(false)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)

  case     Case @relation(fields: [caseId], references: [id])
  user     User @relation("AssignedTeam", fields: [userId], references: [id])
  assigner User @relation("PerformedAssignments", fields: [assignedBy], references: [id])

  @@index([caseId, endDate])
  @@map("case_team_histories")
}

model CaseOfficeHistory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId        String    @db.Uuid
  officeId      String    @db.Uuid
  startDate     DateTime  @default(now()) @db.Timestamptz(6)
  endDate       DateTime? @db.Timestamptz(6)
  reason        String
  transferredBy String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  case        Case   @relation(fields: [caseId], references: [id])
  office      Office @relation(fields: [officeId], references: [id])
  transferrer User   @relation("TransferredOffice", fields: [transferredBy], references: [id])

  @@map("case_office_histories")
}

model InterventionPathHistory {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId    String           @db.Uuid
  path      InterventionPath
  startDate DateTime         @default(now()) @db.Timestamptz(6)
  endDate   DateTime?        @db.Timestamptz(6)
  reason    String
  changedBy String           @db.Uuid
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  case    Case @relation(fields: [caseId], references: [id])
  changer User @relation("PathChangedBy", fields: [changedBy], references: [id])

  @@map("intervention_path_histories")
}

model ActionLog {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String     @db.Uuid
  authorId   String     @db.Uuid
  actionType ActionType
  title      String
  content    String
  isSigned   Boolean    @default(false)
  signedAt   DateTime?  @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)

  case   Case @relation(fields: [caseId], references: [id])
  author User @relation("ActionAuthor", fields: [authorId], references: [id])

  @@map("action_logs")
}

model Report {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String       @db.Uuid
  authorId       String       @db.Uuid
  version        Int          @default(1)
  parentReportId String?      @db.Uuid
  title          String
  content        String
  riskAssessment RiskLevel?
  status         ReportStatus @default(BORRADOR)
  emittedAt      DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  case         Case     @relation(fields: [caseId], references: [id])
  author       User     @relation("ReportAuthor", fields: [authorId], references: [id])
  parentReport Report?  @relation("ComplementaryReports", fields: [parentReportId], references: [id])
  children     Report[] @relation("ComplementaryReports")

  disciplineReportTypeId String               @db.Uuid
  disciplineReportType   DisciplineReportType @relation(fields: [disciplineReportTypeId], references: [id])

  coAuthorId String? @db.Uuid
  coAuthor   User?   @relation("ReportCoAuthor", fields: [coAuthorId], references: [id])

  authorRoleSnapshot       Role?
  authorDisciplineSnapshot String?

  @@map("reports")
}

model Evidence {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId              String              @db.Uuid
  uploadedBy          String              @db.Uuid
  fileName            String
  mimeType            String
  fileSize            Int
  storagePath         String
  fileHash            String
  isSensitive         Boolean             @default(false)
  description         String?
  transcriptionStatus TranscriptionStatus @default(DIGITAL_NATIVO)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)

  case            Case              @relation(fields: [caseId], references: [id])
  uploader        User              @relation("EvidenceUploader", fields: [uploadedBy], references: [id])
  
  transcriptions  Transcription[]

  @@map("evidences")
}

model Appointment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId          String            @db.Uuid
  title           String
  description     String?
  appointmentType AppointmentType
  scheduledAt     DateTime?         @db.Timestamptz(6)   // opcional si secretaria no define fecha
  endAt           DateTime?         @db.Timestamptz(6)
  location        String?
  status          AppointmentStatus @default(PROPUESTA)  // inicia como propuesta
  createdBy       String            @db.Uuid             // quien crea (secretaria/jefatura)
  assignedProfessionalId String?    @db.Uuid             // profesional que atenderá

  // Respuesta del profesional
  professionalResponse  String?    // ACCEPTED | MODIFIED | REJECTED
  professionalNotes     String?    // observaciones del profesional al aceptar/modificar
  respondedAt           DateTime?  @db.Timestamptz(6)   // cuándo respondió

  case                Case    @relation(fields: [caseId], references: [id])
  creator             User    @relation("CreatedAppointments", fields: [createdBy], references: [id])
  assignedProfessional User?  @relation("AssignedAppointments", fields: [assignedProfessionalId], references: [id])

  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  
  questionnaires  QuestionnaireResponse[]

  @@index([assignedProfessionalId])
  @@map("appointments")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  caseId      String?          @db.Uuid
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  readAt      DateTime?        @db.Timestamptz(6)
  priority    Priority         @default(NORMAL)
  expiresAt   DateTime?        @db.Timestamptz(6)
  escalatedTo String?          @db.Uuid
  escalatedAt DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)

  user      User  @relation("UserNotifications", fields: [userId], references: [id])
  case      Case? @relation(fields: [caseId], references: [id])
  escalator User? @relation("EscalatedNotifications", fields: [escalatedTo], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String   @db.Uuid
  userRole   String
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String   @db.Uuid
  user        User     @relation(fields: [updatedBy], references: [id])
}

model Establishment {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  category    String // BAR_DISCOTECA, INTERNET_JUEGOS, TERMINAL_TRANSPORTE, OTRO
  address     String?
  ownerName   String?
  phone       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  inspections Inspection[]
}

model Inspection {
  id                    String                    @id @default(uuid()) @db.Uuid
  establishmentId       String                    @db.Uuid
  establishment         Establishment             @relation(fields: [establishmentId], references: [id])
  
  caseId                String?                   @db.Uuid
  case                  Case?                     @relation(fields: [caseId], references: [id])
  
  officeId              String                    @db.Uuid
  inspectorId           String                    @db.Uuid
  inspector             User                      @relation(fields: [inspectorId], references: [id])
  
  scheduledAt           DateTime                  @db.Timestamptz(6)
  completedAt           DateTime?                 @db.Timestamptz(6)
  
  status                String
  isSurpriseInspection  Boolean                   @default(false)
  generalNotes          String?                   @db.Text
  
  location              InspectionLocation?
  findings              InspectionFinding[]
  evidenceFiles         InspectionEvidenceFile[]
  
  inspectorIds          String[]                  @db.Uuid @default([])
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  createdBy             String?                   @db.Uuid
  
  @@index([caseId])
  @@map("Inspection")
}

model InspectionLocation {
  id              String      @id @default(uuid()) @db.Uuid
  inspectionId    String      @db.Uuid @unique
  inspection      Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  latitude        Float
  longitude       Float
  address         String?
  googleMapsUrl   String?
  
  @@map("inspection_locations")
}

model InspectionEvidenceFile {
  id              String                    @id @default(uuid()) @db.Uuid
  inspectionId    String                    @db.Uuid
  inspection      Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  fileName        String
  mimeType        String
  fileSize        Int
  
  storagePath     String
  fileHash        String                    @unique
  
  description     String?
  evidenceType    InspectionEvidenceType
  
  uploadedBy      String                    @db.Uuid
  uploader        User                      @relation("InspectionEvidenceUploader", fields: [uploadedBy], references: [id])
  
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  
  @@index([inspectionId])
  @@map("inspection_evidence_files")
}

model InspectionFinding {
  id                String              @id @default(uuid()) @db.Uuid
  inspectionId      String              @db.Uuid
  inspection        Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  findingCategory   String
  severity          InspectionSeverity
  description       String              @db.Text
  recommendations   String?             @db.Text
  
  nnaCount          Int?
  photosEvidenceIds String[]            @db.Uuid @default([])
  
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  
  @@map("inspection_findings")
}

model SystemCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

