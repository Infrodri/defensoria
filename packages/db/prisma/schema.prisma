generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMINISTRADOR
  JEFATURA
  ABOGADO
  PSICOLOGO
  SOCIAL
  SECRETARIA
  REFERENTE_TUTOR
}

enum DocumentType {
  CI
  PASAPORTE
  PARTIDA_NACIMIENTO
  SIN_DOCUMENTO
}

enum Gender {
  MASCULINO
  FEMENINO
  OTRO
}

enum CaseType {
  DENUNCIA_VULNERACION
  CONSUMO_SUSTANCIAS
  VENTA_ALCOHOL
  DERECHO_EDUCACION
  EXTRAVIO
  NNA_INFRACTOR
  FISCALIZACION
}

enum Phase {
  DERIVACION
  EVALUACION
  SEGUIMIENTO
  JUDICIALIZACION
  CIERRE
}

enum InterventionPath {
  GESTION_ADMINISTRATIVA
  CONCILIACION
  VIA_JUDICIAL
}

enum RiskLevel {
  BAJO
  MEDIO
  ALTO
}

enum RoleInCase {
  NNA
  DENUNCIANTE
  DENUNCIADO
  TUTOR
  TESTIGO
}

enum ActionType {
  NOTA
  ENTREVISTA
  VISITA_DOMICILIARIA
  AUDIENCIA
  DERIVACION
  CONTACTO_INSTITUCIONAL
  OTRO
}

enum ReportType {
  INFORME_SOCIAL
  INFORME_PSICOLOGICO
  INFORME_PSICOSOCIAL
  INFORME_JURIDICO
}

enum ReportStatus {
  BORRADOR
  EMITIDO
}

enum AppointmentType {
  ENTREVISTA
  AUDIENCIA
  VISITA_DOMICILIARIA
  SEGUIMIENTO
  OTRO
}

enum AppointmentStatus {
  PROGRAMADA
  COMPLETADA
  CANCELADA
  REPROGRAMADA
}

enum NotificationType {
  PLAZO_LEGAL
  RIESGO_ALTO
  ASIGNACION
  DERIVACION
  GENERAL
}

enum Priority {
  NORMAL
  URGENTE
  CRITICA
}

enum TranscriptionStatus {
  DIGITAL_NATIVO
  OCR_AUTOMATICO
  VALIDADO_HUMANO
}

enum InspectionEvidenceType {
  FOTO
  VIDEO
  DOCUMENTO
}

enum InspectionSeverity {
  BAJA
  MEDIA
  ALTA
}

enum QuestionnaireCategory {
  PSICOLOGICO
  SOCIAL
  JURIDICO
  GENERAL
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
  BOOLEAN
  RATING
  DATE
}

enum QuestionnaireResponseStatus {
  PENDIENTE
  COMPLETADA
  REVISADA
}

enum TranscriptionTaskStatus {
  PENDIENTE
  COMPLETADA
  ERROR
}

enum DiscrepancyRiskLevel {
  BAJO
  MEDIO
  ALTO
}

enum ProcessualStatus {
  EN_TIEMPO
  PROXIMO
  VENCIDO
}

enum ProcessualAlertLevel {
  VERDE
  AMARILLO
  ROJO
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             Role
  officeId         String?   @db.Uuid
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  office                 Office?                   @relation(fields: [officeId], references: [id])
  createdPersons         Person[]                  @relation("CreatedPersons")
  createdCases           Case[]                    @relation("CreatedCases")
  closedCases            Case[]                    @relation("ClosedCases")
  createdCaseParties     CaseParty[]               @relation("CreatedCaseParties")
  assignedCaseTeam       CaseTeamHistory[]         @relation("AssignedTeam")
  performedAssignments   CaseTeamHistory[]         @relation("PerformedAssignments")
  performedTransfers     CaseOfficeHistory[]       @relation("TransferredOffice")
  performedPathChanges   InterventionPathHistory[] @relation("PathChangedBy")
  authoredActions        ActionLog[]               @relation("ActionAuthor")
  authoredReports        Report[]                  @relation("ReportAuthor")
  uploadedEvidences      Evidence[]                @relation("EvidenceUploader")
  inspectionEvidenceUploaded InspectionEvidenceFile[] @relation("InspectionEvidenceUploader")
  createdAppointments    Appointment[]             @relation("CreatedAppointments")
  notifications          Notification[]            @relation("UserNotifications")
  escalatedNotifications Notification[]            @relation("EscalatedNotifications")
  auditLogs              AuditLog[]
  systemSettings         SystemSetting[]
  inspections            Inspection[]

  disciplineId String?     @db.Uuid
  discipline   Discipline? @relation(fields: [disciplineId], references: [id])
  
  questionnairesCreated   QuestionnaireTemplate[]   @relation("QuestionnaireCreator")
  questionnairesAnswered  QuestionnaireResponse[]   @relation("QuestionnaireResponses")
  transcriptionsCreated   Transcription[]           @relation("TranscriptionsCreated")
  
  discrepancyAnalysisCreated DiscrepancyAnalysis[]  @relation("DiscrepancyAnalysts")
  penalTypicityAnalysisCreated PenalTypicityAnalysis[] @relation("PenalTypicityAnalysts")
  processualDeadlineCreated ProcessualDeadline[]     @relation("ProcessualDeadlineCreators")

  transversalTimelinesCreated TransversalUnifiedTimeline[] @relation("TransversalTimelineCreators")
  transversalReportsCreated TransversalAnonymizedReport[] @relation("TransversalReportCreators")

  @@map("users")
}

model Office {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users           User[]
  currentCases    Case[]              @relation("CurrentOfficeCases")
  officeHistories CaseOfficeHistory[]

  @@map("offices")
}

model Person {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType   DocumentType @default(SIN_DOCUMENTO)
  documentNumber String?
  firstName      String
  lastName       String
  birthDate      DateTime?    @db.Date
  gender         Gender       @default(OTRO)
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  createdBy      String       @db.Uuid

  creator     User        @relation("CreatedPersons", fields: [createdBy], references: [id])
  caseParties CaseParty[]

  @@map("persons")
}

model Case {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseCode                String           @unique
  caseType                CaseType
  currentPhase            Phase            @default(DERIVACION)
  currentInterventionPath InterventionPath @default(GESTION_ADMINISTRATIVA)
  riskLevel               RiskLevel?
  intakeNarrative         String
  isClosed                Boolean          @default(false)
  closedAt                DateTime?        @db.Timestamptz(6)
  closedBy                String?          @db.Uuid
  closureReason           String?
  accessPinHash           String?
  currentOfficeId         String           @db.Uuid
  createdAt               DateTime         @default(now()) @db.Timestamptz(6)
  createdBy               String           @db.Uuid
  updatedAt               DateTime         @updatedAt @db.Timestamptz(6)

  creator       User                      @relation("CreatedCases", fields: [createdBy], references: [id])
  closer        User?                     @relation("ClosedCases", fields: [closedBy], references: [id])
  currentOffice Office                    @relation("CurrentOfficeCases", fields: [currentOfficeId], references: [id])
  parties       CaseParty[]
  teamHistory   CaseTeamHistory[]
  officeHistory CaseOfficeHistory[]
  pathHistory   InterventionPathHistory[]
  actionLogs    ActionLog[]
  reports       Report[]
  evidences     Evidence[]
  appointments  Appointment[]
  notifications Notification[]
  
  inspections   Inspection[]
  questionnaires QuestionnaireResponse[]
  transcriptions Transcription[]
  
  discrepancyAnalyses DiscrepancyAnalysis[] @relation("CaseDiscrepancies")
  penalTypicityAnalyses PenalTypicityAnalysis[] @relation("CasePenalTypicities")
  processualDeadlines ProcessualDeadline[] @relation("CaseProcessualDeadlines")

  transversalTimelines TransversalUnifiedTimeline[] @relation("CaseTransversalTimelines")
  transversalReports TransversalAnonymizedReport[] @relation("CaseTransversalReports")

  @@index([currentPhase])
  @@index([riskLevel])
  @@index([isClosed])
  @@index([currentOfficeId])
  @@map("cases")
}

model CaseParty {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String     @db.Uuid
  personId   String     @db.Uuid
  roleInCase RoleInCase
  isPrimary  Boolean    @default(false)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  createdBy  String     @db.Uuid

  case    Case   @relation(fields: [caseId], references: [id])
  person  Person @relation(fields: [personId], references: [id])
  creator User   @relation("CreatedCaseParties", fields: [createdBy], references: [id])

  @@unique([caseId, personId, roleInCase])
  @@map("case_parties")
}

model CaseTeamHistory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String    @db.Uuid
  userId     String    @db.Uuid
  role       Role
  startDate  DateTime  @default(now()) @db.Timestamptz(6)
  endDate    DateTime? @db.Timestamptz(6)
  reason     String
  assignedBy String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  case     Case @relation(fields: [caseId], references: [id])
  user     User @relation("AssignedTeam", fields: [userId], references: [id])
  assigner User @relation("PerformedAssignments", fields: [assignedBy], references: [id])

  @@index([caseId, endDate])
  @@map("case_team_histories")
}

model CaseOfficeHistory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId        String    @db.Uuid
  officeId      String    @db.Uuid
  startDate     DateTime  @default(now()) @db.Timestamptz(6)
  endDate       DateTime? @db.Timestamptz(6)
  reason        String
  transferredBy String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  case        Case   @relation(fields: [caseId], references: [id])
  office      Office @relation(fields: [officeId], references: [id])
  transferrer User   @relation("TransferredOffice", fields: [transferredBy], references: [id])

  @@map("case_office_histories")
}

model InterventionPathHistory {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId    String           @db.Uuid
  path      InterventionPath
  startDate DateTime         @default(now()) @db.Timestamptz(6)
  endDate   DateTime?        @db.Timestamptz(6)
  reason    String
  changedBy String           @db.Uuid
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  case    Case @relation(fields: [caseId], references: [id])
  changer User @relation("PathChangedBy", fields: [changedBy], references: [id])

  @@map("intervention_path_histories")
}

model ActionLog {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String     @db.Uuid
  authorId   String     @db.Uuid
  actionType ActionType
  title      String
  content    String
  isSigned   Boolean    @default(false)
  signedAt   DateTime?  @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)

  case   Case @relation(fields: [caseId], references: [id])
  author User @relation("ActionAuthor", fields: [authorId], references: [id])

  @@map("action_logs")
}

model Report {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String       @db.Uuid
  authorId       String       @db.Uuid
  reportType     ReportType
  version        Int          @default(1)
  parentReportId String?      @db.Uuid
  title          String
  content        String
  riskAssessment RiskLevel?
  status         ReportStatus @default(BORRADOR)
  emittedAt      DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  case         Case     @relation(fields: [caseId], references: [id])
  author       User     @relation("ReportAuthor", fields: [authorId], references: [id])
  parentReport Report?  @relation("ComplementaryReports", fields: [parentReportId], references: [id])
  children     Report[] @relation("ComplementaryReports")

  disciplineReportTypeId String?               @db.Uuid
  disciplineReportType   DisciplineReportType? @relation(fields: [disciplineReportTypeId], references: [id])

  authorRoleSnapshot       Role?
  authorDisciplineSnapshot String?

  @@map("reports")
}

model Evidence {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId              String              @db.Uuid
  uploadedBy          String              @db.Uuid
  fileName            String
  mimeType            String
  fileSize            Int
  storagePath         String
  fileHash            String
  isSensitive         Boolean             @default(false)
  description         String?
  transcriptionStatus TranscriptionStatus @default(DIGITAL_NATIVO)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)

  case            Case              @relation(fields: [caseId], references: [id])
  uploader        User              @relation("EvidenceUploader", fields: [uploadedBy], references: [id])
  
  transcriptions  Transcription[]

  @@map("evidences")
}

model Appointment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId          String            @db.Uuid
  title           String
  description     String?
  appointmentType AppointmentType
  scheduledAt     DateTime          @db.Timestamptz(6)
  endAt           DateTime?         @db.Timestamptz(6)
  location        String?
  status          AppointmentStatus @default(PROGRAMADA)
  createdBy       String            @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  case            Case              @relation(fields: [caseId], references: [id])
  creator         User              @relation("CreatedAppointments", fields: [createdBy], references: [id])
  
  questionnaires  QuestionnaireResponse[]

  @@map("appointments")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  caseId      String?          @db.Uuid
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  readAt      DateTime?        @db.Timestamptz(6)
  priority    Priority         @default(NORMAL)
  expiresAt   DateTime?        @db.Timestamptz(6)
  escalatedTo String?          @db.Uuid
  escalatedAt DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)

  user      User  @relation("UserNotifications", fields: [userId], references: [id])
  case      Case? @relation(fields: [caseId], references: [id])
  escalator User? @relation("EscalatedNotifications", fields: [escalatedTo], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String   @db.Uuid
  userRole   String
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String   @db.Uuid
  user        User     @relation(fields: [updatedBy], references: [id])
}

model Establishment {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  category    String // BAR_DISCOTECA, INTERNET_JUEGOS, TERMINAL_TRANSPORTE, OTRO
  address     String?
  ownerName   String?
  phone       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  inspections Inspection[]
}

model Inspection {
  id                    String                    @id @default(uuid()) @db.Uuid
  establishmentId       String                    @db.Uuid
  establishment         Establishment             @relation(fields: [establishmentId], references: [id])
  
  caseId                String?                   @db.Uuid
  case                  Case?                     @relation(fields: [caseId], references: [id])
  
  officeId              String                    @db.Uuid
  inspectorId           String                    @db.Uuid
  inspector             User                      @relation(fields: [inspectorId], references: [id])
  
  scheduledAt           DateTime                  @db.Timestamptz(6)
  completedAt           DateTime?                 @db.Timestamptz(6)
  
  status                String
  isSurpriseInspection  Boolean                   @default(false)
  generalNotes          String?                   @db.Text
  
  location              InspectionLocation?
  findings              InspectionFinding[]
  evidenceFiles         InspectionEvidenceFile[]
  
  inspectorIds          String[]                  @db.Uuid @default([])
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  createdBy             String?                   @db.Uuid
  
  @@index([caseId])
  @@map("Inspection")
}

model InspectionLocation {
  id              String      @id @default(uuid()) @db.Uuid
  inspectionId    String      @db.Uuid @unique
  inspection      Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  latitude        Float
  longitude       Float
  address         String?
  googleMapsUrl   String?
  
  @@map("inspection_locations")
}

model InspectionEvidenceFile {
  id              String                    @id @default(uuid()) @db.Uuid
  inspectionId    String                    @db.Uuid
  inspection      Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  fileName        String
  mimeType        String
  fileSize        Int
  
  storagePath     String
  fileHash        String                    @unique
  
  description     String?
  evidenceType    InspectionEvidenceType
  
  uploadedBy      String                    @db.Uuid
  uploader        User                      @relation("InspectionEvidenceUploader", fields: [uploadedBy], references: [id])
  
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  
  @@index([inspectionId])
  @@map("inspection_evidence_files")
}

model InspectionFinding {
  id                String              @id @default(uuid()) @db.Uuid
  inspectionId      String              @db.Uuid
  inspection        Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  findingCategory   String
  severity          InspectionSeverity
  description       String              @db.Text
  recommendations   String?             @db.Text
  
  nnaCount          Int?
  photosEvidenceIds String[]            @db.Uuid @default([])
  
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  
  @@map("inspection_findings")
}

model SystemCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  items       CatalogItem[]

  @@map("system_catalogs")
}

model CatalogItem {
  id          String   @id @default(uuid()) @db.Uuid
  catalogId   String   @db.Uuid
  value       String
  label       String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  catalog     SystemCatalog @relation(fields: [catalogId], references: [id])

  @@unique([catalogId, value])
  @@map("catalog_items")
}

model SystemModule {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?  @db.Text
  permissions Json // Stores RBAC matrix permissions for each role
  isCustom    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_modules")
}

model Discipline {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  users       User[]
  reportTypes DisciplineReportType[]
  instruments Instrument[]

  @@map("disciplines")
}

model DisciplineReportType {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId String   @db.Uuid
  code         String   @unique
  name         String
  description  String?
  template     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  discipline Discipline @relation(fields: [disciplineId], references: [id])
  reports    Report[]

  @@map("discipline_report_types")
}

model DocumentTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType String   @unique
  structure    Json
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("document_templates")
}

model Instrument {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId      String   @db.Uuid
  instrumentType    String
  name              String
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  structuredContent Json
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  discipline Discipline @relation(fields: [disciplineId], references: [id])

  @@map("instruments")
}

model LegalDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   
  sourceUrl   String?
  publishedAt DateTime?
  isActive    Boolean  @default(true)
  version     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  
  chunks      LegalChunk[]

  @@map("legal_documents")
}

model LegalChunk {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalDocumentId String   @db.Uuid
  content         String   
  metadata        Json     
  
  embedding       Unsupported("vector(768)")?
  
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  document        LegalDocument @relation(fields: [legalDocumentId], references: [id])

  @@map("legal_chunks")
}

model QuestionnaireTemplate {
  id              String                      @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  category        QuestionnaireCategory
  version         Int                         @default(1)
  
  questions       Question[]
  responses       QuestionnaireResponse[]
  
  isActive        Boolean                     @default(true)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  createdBy       String                      @db.Uuid
  creator         User                        @relation("QuestionnaireCreator", fields: [createdBy], references: [id])
  
  @@map("questionnaire_templates")
}

model Question {
  id                String                @id @default(uuid()) @db.Uuid
  templateId        String                @db.Uuid
  template          QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  question          String                @db.Text
  questionType      QuestionType
  
  order             Int
  required          Boolean               @default(true)
  
  options           String[]
  riskKeywords      String[]              @default([])
  
  answers           Answer[]
  
  @@map("questions")
}

model QuestionnaireResponse {
  id              String                      @id @default(uuid()) @db.Uuid
  templateId      String                      @db.Uuid
  template        QuestionnaireTemplate       @relation(fields: [templateId], references: [id])
  
  caseId          String                      @db.Uuid
  case            Case                        @relation(fields: [caseId], references: [id])
  
  appointmentId   String?                     @db.Uuid
  appointment     Appointment?                @relation(fields: [appointmentId], references: [id])
  
  respondentId    String                      @db.Uuid
  respondent      User                        @relation("QuestionnaireResponses", fields: [respondentId], references: [id])
  
  completedAt     DateTime?
  answers         Answer[]
  
  riskFlags       String[]                    @default([])
  riskScore       Float?                      @default(0)
  
  status          QuestionnaireResponseStatus @default(PENDIENTE)
  notes           String?                     @db.Text
  
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(6)
  
  @@index([caseId])
  @@index([status])
  @@map("questionnaire_responses")
}

model Answer {
  id              String                  @id @default(uuid()) @db.Uuid
  responseId      String                  @db.Uuid
  response        QuestionnaireResponse   @relation(fields: [responseId], references: [id], onDelete: Cascade)
  
  questionId      String                  @db.Uuid
  question        Question                @relation(fields: [questionId], references: [id])
  
  answer          String                  @db.Text
  
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  
  @@map("answers")
}

model Transcription {
  id              String                  @id @default(uuid()) @db.Uuid
  caseId          String                  @db.Uuid
  case            Case                    @relation(fields: [caseId], references: [id])
  
  evidenceId      String                  @db.Uuid
  evidence        Evidence                @relation(fields: [evidenceId], references: [id])
  
  text            String                  @db.Text
  
  duration        String?
  confidence      Float                   @default(0.95)
  language        String                  @default("es")
  
  searchIndex     String?
  
  status          TranscriptionTaskStatus @default(PENDIENTE)
  errorMessage    String?
  
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  createdBy       String                  @db.Uuid
  creator         User                    @relation("TranscriptionsCreated", fields: [createdBy], references: [id])
  
  discrepancyAnalysesAsTarget DiscrepancyAnalysis[] @relation("DiscrepancyCurrentTranscription")
  penalTypicityAnalyses PenalTypicityAnalysis[] @relation("PenalTypicityTranscriptions")
  
  @@map("transcriptions")
}

// =====================================================
// LEGAL TOOLS - 3 TABLAS NUEVAS (FASE 2)
// =====================================================

model DiscrepancyAnalysis {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId                String                @db.Uuid
  case                  Case                  @relation("CaseDiscrepancies", fields: [caseId], references: [id], onDelete: Cascade)
  
  currentTranscriptionId String               @db.Uuid
  currentTranscription  Transcription         @relation("DiscrepancyCurrentTranscription", fields: [currentTranscriptionId], references: [id], onDelete: Cascade)
  
  comparableDocumentIds String[]              @db.Uuid @default([])
  
  discrepancies         Json                                              // Array de discrepancias detectadas
  consistencyScore      Float                 @default(0)                // 0-100
  riskLevel             DiscrepancyRiskLevel
  recommendation        String?               @db.Text
  
  analyzedAt            DateTime              @default(now()) @db.Timestamptz(6)
  analyzedBy            String                @db.Uuid
  analyst               User                  @relation("DiscrepancyAnalysts", fields: [analyzedBy], references: [id])
  
  @@index([caseId])
  @@index([analyzedAt])
  @@map("discrepancy_analyses")
}

model PenalTypicityAnalysis {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String                @db.Uuid
  case              Case                  @relation("CasePenalTypicities", fields: [caseId], references: [id], onDelete: Cascade)
  
  transcriptionId   String                @db.Uuid
  transcription     Transcription         @relation("PenalTypicityTranscriptions", fields: [transcriptionId], references: [id], onDelete: Cascade)
  
  potentialCrimes   Json                                                  // Array de delitos potenciales
  primaryCrime      String                                                // Delito principal
  secondaryCrimes   String[]              @default([])
  evidenceGaps      String[]              @default([])
  investigationPath String?               @db.Text
  
  analyzedAt        DateTime              @default(now()) @db.Timestamptz(6)
  analyzedBy        String                @db.Uuid
  analyst           User                  @relation("PenalTypicityAnalysts", fields: [analyzedBy], references: [id])
  
  @@index([caseId])
  @@index([analyzedAt])
  @@map("penal_typicality_analyses")
}

model ProcessualDeadline {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String                @db.Uuid
  case              Case                  @relation("CaseProcessualDeadlines", fields: [caseId], references: [id], onDelete: Cascade)
  
  milestone         String                                                // "Audiencia Preliminar", etc.
  calculatedDate    DateTime
  daysRemaining     Int
  status            ProcessualStatus
  urgency           Int                   @default(0)                    // 0-100
  alertLevel        ProcessualAlertLevel
  relatedLaws       String[]              @default([])                   // ["Ley 548", "Art. 102"]
  
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  createdBy         String                @db.Uuid
  creator           User                  @relation("ProcessualDeadlineCreators", fields: [createdBy], references: [id])
  
  @@index([caseId])
  @@index([calculatedDate])
  @@map("processual_deadlines")
}

// =====================================================
// TRANSVERSAL TOOLS - 2 TABLAS NUEVAS (FASE 2)
// =====================================================

model TransversalUnifiedTimeline {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String    @db.Uuid
  case              Case      @relation("CaseTransversalTimelines", fields: [caseId], references: [id], onDelete: Cascade)
  
  events            Json      // Array de eventos unificados de legal, psicologico y social
  
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  createdBy         String    @db.Uuid
  creator           User      @relation("TransversalTimelineCreators", fields: [createdBy], references: [id])

  @@index([caseId])
  @@map("transversal_unified_timelines")
}

model TransversalAnonymizedReport {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId            String    @db.Uuid
  case              Case      @relation("CaseTransversalReports", fields: [caseId], references: [id], onDelete: Cascade)
  
  originalReportId  String    @db.Uuid
  anonymizedContent String    @db.Text
  replacements      Json      // Diccionario de reemplazos
  
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  createdBy         String    @db.Uuid
  creator           User      @relation("TransversalReportCreators", fields: [createdBy], references: [id])

  @@index([caseId])
  @@map("transversal_anonymized_reports")
}

// =====================================================
// ADMIN TOOLS - VERIFICACIÓN Y APROBACIÓN (FASE 2)
// =====================================================
model ToolApproval {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvedAt      DateTime  @default(now()) @db.Timestamptz(6)
  approvedBy      String    // Nombre o email del admin que aprobó
  status          String    @default("APPROVED") // APPROVED, REJECTED, PENDING
  notes           String?   @db.Text // Notas del admin
  healthSnapshot  String?   @db.Text // JSON string del health check al momento de aprobación
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([approvedAt])
  @@map("tool_approvals")
}
